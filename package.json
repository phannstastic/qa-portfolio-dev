{
  "name": "qa-portfolio-elysia",
  "version": "0.1.0",
  "description": "Personal QA Portfolio CMS built with ElysiaJS, Drizzle ORM, and MySQL",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "elysia": "^1.2.25",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.7.3"
  }
}
