# Server Environment
NODE_ENV=development
PORT=3000

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=qa_portfolio

# Authentication & Security
# Note: In production or when JWT auth is implemented, provide a strong secret key
JWT_SECRET=your_jwt_secret_min_32_chars_placeholder

# Database Seeding Configuration
# Note: SEED_ADMIN_PASSWORD is required when executing 'bun run db:seed'
ADMIN_EMAIL=admin@qa-portfolio.local
SEED_ADMIN_PASSWORD=your_secure_seed_password_here

# E2E Test Database Configuration (Isolated)
# Tests fail-fast if pointing to qa_portfolio_dev or qa_playground_db
E2E_DB_NAME=qa_portfolio_e2e_test
